{
  "name": "karsathi",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "scripts": {
    "dev": "docker compose up -d && pnpm dev:apps",
    "dev:apps": "concurrently -k -n api,web -c blue,green \"pnpm --filter @karsathi/api dev\" \"pnpm --filter @karsathi/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "seed": "pnpm --filter @karsathi/api seed",
    "sample:excel": "pnpm --filter @karsathi/api sample:excel"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "~5.7.2"
  }
}
