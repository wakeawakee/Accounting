# Copy to .env (repo root) and adjust. The API reads it in dev via `tsx --env-file`.
# In production set these as real environment variables on your host.

# --- Core -------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# MongoDB connection string (docker-compose: mongodb://127.0.0.1:27017/karsathi, prod: MongoDB Atlas SRV URL)
MONGO_URL=mongodb://127.0.0.1:27017/karsathi
# Redis for BullMQ job scheduling. Leave empty to use the in-process dev scheduler.
# Prod: Upstash Redis URL, e.g. rediss://default:<password>@<host>:6379
REDIS_URL=redis://127.0.0.1:6379

# --- Secrets (MUST change in production; the API refuses to start with dev defaults) ---
# Signs the session cookie (JWT). Use 32+ random chars: openssl rand -base64 32
JWT_SECRET=dev-only-jwt-secret-change-me
# Signs short-lived document download URLs (local storage driver).
FILE_URL_SECRET=dev-only-file-url-secret-change-me
# Encrypts per-firm SMS gateway tokens stored in MongoDB.
ENCRYPTION_KEY=dev-only-encryption-key-change-me

# --- URLs -------------------------------------------------------------------
# Public URL of the web app; used to build magic upload links sent by SMS (keep it short!).
WEB_URL=http://localhost:5173
# Base URL used in signed document URLs. In dev point it at the Vite proxy so previews are same-origin.
# In prod, use your web domain if /api is rewritten to the API (recommended), else the API domain.
API_PUBLIC_URL=http://localhost:5173
# Comma-separated list of allowed browser origins (CORS).
CORS_ORIGINS=http://localhost:5173
# true in production (HTTPS only cookies)
COOKIE_SECURE=false

# --- File storage -------------------------------------------------------------
# local = disk (dev). s3 = any S3-compatible store (Cloudflare R2, AWS S3, Backblaze B2...)
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage
# R2 example: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Messaging ----------------------------------------------------------------
# Default provider when a firm hasn't configured its own: console | sms | viber (stub)
MESSAGE_PROVIDER=console
# Generic HTTP SMS gateway (POST form fields). Sparrow SMS: https://api.sparrowsms.com/v2/sms/
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=
# Form field names sent to the gateway (defaults match Sparrow SMS)
SMS_FIELD_TOKEN=token
SMS_FIELD_FROM=from
SMS_FIELD_TO=to
SMS_FIELD_TEXT=text
# Used only for cost estimates shown to firms (NPR per SMS segment). Check your gateway's rate.
SMS_COST_PER_SEGMENT_NPR=1

# --- Misc -------------------------------------------------------------------
# Set false to run an API instance without background jobs (e.g. a second web instance)
SCHEDULER_ENABLED=true
LOG_LEVEL=info

# --- Web (Vite) -------------------------------------------------------------
# Leave empty to call /api on the same origin (Vite proxy in dev, Vercel rewrite in prod).
VITE_API_URL=
